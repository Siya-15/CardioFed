# Copy to .env (or export these) - every variable is optional in development.

# API key for programmatic clients (X-API-Key header). Required when CARDIOFED_ENV=production.
# Generate one: python -c "import secrets; print(secrets.token_urlsafe(32))"
CARDIOFED_API_KEY=

# development | production   (production refuses to start without CARDIOFED_API_KEY)
CARDIOFED_ENV=development

# Let the bundled web UI get short-lived session cookies (1 = on, 0 = API-key only)
CARDIOFED_UI_SESSIONS=1
CARDIOFED_SESSION_TTL=3600

# Requests per minute per client (0 disables)
CARDIOFED_RATE_LIMIT=60

# Comma-separated origins allowed to call the API from another site (empty = same-origin only)
CARDIOFED_ALLOWED_ORIGINS=
